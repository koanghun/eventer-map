# Backend Environment Variables
# 이 파일을 복사하여 .env 파일을 생성한 후 실제 값으로 수정하세요.
# 명령어: cp .env.example .env

# 데이터베이스 URL
# SQLite: sqlite:///./data/eventer.db
# PostgreSQL: postgresql://user:password@localhost/dbname
DATABASE_URL=sqlite:///./data/eventer.db

# CORS 허용 출처 (쉼표로 구분, 공백 없이)
# ⚠️ 프로덕션 배포 시 반드시 실제 도메인/IP로 변경하세요!
# 로컬 개발: http://localhost:3000,http://localhost
# 프로덕션 예시: https://yourdomain.com,http://192.168.1.100:3000
CORS_ORIGINS=http://localhost:3000,http://localhost

# Google OAuth 2.0
# Google Cloud Console에서 OAuth 2.0 클라이언트 ID 생성 필요
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# JWT 설정
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 프론트엔드 URL (OAuth 콜백 후 리다이렉트)
FRONTEND_URL=http://localhost:3000
