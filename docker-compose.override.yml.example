version: '3.8'

# 로컬 개발용 오버라이드 파일 예제
# 사용법: docker-compose.override.yml로 복사하여 개인 설정 추가
# 주의: docker-compose.override.yml은 .gitignore에 추가되어 Git에 커밋되지 않음

services:
  openssh-server:
    environment:
      # SSH 공개키 추가 (선택사항)
      # - PUBLIC_KEY=ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQC...
      
      # 비밀번호 설정 (선택사항, 공개키 권장)
      # - PASSWORD_ACCESS=true
      # - USER_PASSWORD=your_secure_password
      
      # 시간대 설정
      - TZ=Asia/Seoul

  # backend-dev:
    # 개발자별 추가 환경 변수
    # environment:
    #   - DEBUG=true
    #   - LOG_LEVEL=debug

  # frontend-dev:
    # 개발자별 추가 환경 변수  
    # environment:
    #   - REACT_APP_DEBUG=true
