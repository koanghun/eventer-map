# ========================
# Event Map - Environment Variables
# ========================
# 이 파일을 복사하여 .env 파일을 생성한 후 실제 값으로 수정하세요.
# 명령어: cp .env.example .env

# ========================
# Backend Configuration
# ========================

# 데이터베이스 URL
# 로컬/개발: sqlite:///./data/eventer.db
# 프로덕션: sqlite:///./data/eventer.db (또는 PostgreSQL URI)
DATABASE_URL=sqlite:///./data/eventer.db

# CORS 허용 출처 (쉼표로 구분)
# ⚠️ 프로덕션 배포 시 반드시 실제 도메인/IP로 변경하세요!
# 예시: https://yourdomain.com,http://192.168.1.100:3000
CORS_ORIGINS=http://localhost:3000,http://localhost

# ========================
# Frontend Configuration
# ========================

# 백엔드 API URL
# 로컬/개발: http://localhost:8000
# 프로덕션: 실제 백엔드 주소 (예: http://your-nas-ip:8000 또는 https://api.yourdomain.com)
REACT_APP_API_URL=http://localhost:8000

# Google Maps API Key
# ⚠️ 필수: Google Cloud Console에서 발급한 API 키를 입력하세요
# ⚠️ 보안: API 키에 HTTP 리퍼러 제한을 반드시 설정하세요!
REACT_APP_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# ========================
# Docker Compose Ports
# ========================

# 백엔드 포트 (기본: 8000)
BACKEND_PORT=8000

# 프론트엔드 포트 (기본: 3000)
FRONTEND_PORT=3000
