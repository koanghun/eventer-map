# Frontend Environment Variables
# 이 파일을 복사하여 .env 파일을 생성한 후 실제 값으로 수정하세요.
# 명령어: cp .env.example .env

# 백엔드 API URL
# 로컬 개발: http://localhost:8000
# 프로덕션: 실제 백엔드 주소 (예: http://your-nas-ip:8000 또는 https://api.yourdomain.com)
REACT_APP_API_URL=http://localhost:8000

# Google Maps API Key
# ⚠️ 필수: Google Cloud Console에서 발급받은 API 키를 입력하세요
# ⚠️ 보안 필수 조치 (Google Cloud Console에서 설정):
#    1. API 제한: Maps JavaScript API, Geocoding API만 활성화
#    2. HTTP 리퍼러 제한: 프로덕션 도메인만 허용 (예: https://yourdomain.com/*)
#    3. IP 주소 제한 (선택): NAS의 공인 IP만 허용
REACT_APP_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# 프로덕션 환경에서는 쿠키가 https에서만 전송되도록 설정
COOKIE_SECURE=true 