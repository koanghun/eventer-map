# ============================================
# Eventer Map - 환경 변수 설정
# ============================================
# 이 파일을 복사하여 사용하세요:
# - 개발: cp .env.example .env (포트 7772-7774 사용)
# - 배포: cp .env.example .env (포트 65104-65105 사용)

# ========================
# Docker Compose 포트 설정
# ========================

# 백엔드 포트
# 개발: 7773 / 배포: 65105
BACKEND_PORT=7773

# 프론트엔드 포트  
# 개발: 7772 / 배포: 65104
FRONTEND_PORT=7772

# SSH 포트 (선택사항, docker-compose --profile ssh up -d로 실행 시만 사용)
# 개발: 7774
SSH_PORT=7774

# ========================
# Backend 설정
# ========================

# 데이터베이스 URL (SQLite)
DATABASE_URL=sqlite:///./data/eventer.db

# CORS 허용 출처 (쉼표로 구분, 공백 없이)
# 로컬: http://localhost:7772,http://localhost
# NAS: http://192.168.1.100:7772,http://192.168.1.100
CORS_ORIGINS=http://localhost:7772,http://localhost

# ========================
# Frontend 설정
# ========================

# React 앱 API URL
# 로컬: http://localhost:7773
# NAS: http://192.168.1.100:7773
REACT_APP_API_URL=http://localhost:7773

# Google Maps API 키 (필수)
# https://console.cloud.google.com/ 에서 발급
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
