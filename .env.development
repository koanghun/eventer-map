# ============================================
# 개발 환경 설정
# ============================================

# 백엔드 포트
BACKEND_PORT=8000

# 프론트엔드 포트
FRONTEND_PORT=3000

# 데이터베이스 설정 (PostgreSQL)
POSTGRES_USER=eventer
POSTGRES_PASSWORD=eventer_pass
POSTGRES_DB=eventer_db
# 🚨 <NAS_IP_ADDRESS> 자리에 실제 NAS의 IP를 기입하세요.
DATABASE_URL=postgresql://eventer:eventer_pass@<NAS_IP_ADDRESS>/eventer_db

# CORS 허용 출처
CORS_ORIGINS=http://localhost:3000,http://localhost

# React 앱 API URL (로컬 백엔드 주소)
REACT_APP_API_URL=http://localhost:8000

# Google Maps API 키 (본인의 키로 교체 필요)
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
