version: '3.8'

services:
  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
    container_name: eventer-map-backend
    ports:
      # 호스트포트:컨테이너포트
      # .env 파일의 BACKEND_PORT 사용, 없으면 8000번 사용
      - "${BACKEND_PORT:-8000}:8000"
    environment:
      # 데이터베이스 연결 문자열 (SQLite 사용)
      - DATABASE_URL=${DATABASE_URL:-sqlite:///./data/eventer.db}
      # CORS 허용 출처 (브라우저에서 API 접근을 허용할 주소)
      - CORS_ORIGINS=${CORS_ORIGINS:-http://localhost:3000,http://localhost}
    volumes:
      # 데이터 영속성을 위한 볼륨만 유지
      # SQLite 데이터베이스 파일이 여기에 저장됨
      # 컨테이너 재시작/삭제해도 데이터 유지
      - backend-data:/app/data
    restart: unless-stopped
    healthcheck:
      # 헬스체크: 백엔드가 정상 작동하는지 주기적으로 확인
      # /health 엔드포인트에 요청을 보내 응답을 확인
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 30s      # 30초마다 체크
      timeout: 10s       # 10초 안에 응답 없으면 실패
      retries: 3         # 3번 연속 실패하면 unhealthy 상태
      start_period: 40s  # 시작 후 40초는 실패해도 무시 (초기화 시간)
    networks:
      - eventer-network
    logging:
      # 로그 파일 크기 제한 (디스크 공간 관리)
      driver: "json-file"
      options:
        max-size: "10m"  # 로그 파일 하나당 최대 10MB
        max-file: "3"    # 최대 3개 파일 유지 (총 30MB)

  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile
      args:
        # React 빌드 시 환경 변수 주입
        # 프론트엔드는 nginx에서 /api를 backend:8000으로 프록시
        - REACT_APP_API_URL=${REACT_APP_API_URL:-http://localhost:8000}
        # Google Maps API 키 (필수)
        - REACT_APP_GOOGLE_MAPS_API_KEY=${REACT_APP_GOOGLE_MAPS_API_KEY}
    container_name: eventer-map-frontend
    ports:
      # 호스트포트:컨테이너포트(nginx 기본 80번)
      - "${FRONTEND_PORT:-3000}:80"
    depends_on:
      # 백엔드가 healthy 상태가 되어야 프론트엔드 시작
      # 백엔드 API가 준비된 후에 프론트엔드 서비스 시작
      backend:
        condition: service_healthy
    restart: unless-stopped
    healthcheck:
      # nginx가 정상 작동하는지 확인
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost/"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s  # nginx는 빠르게 시작되므로 10초면 충분
    networks:
      - eventer-network
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

volumes:
  backend-data:
    # Docker가 관리하는 로컬 볼륨
    # /var/lib/docker/volumes/eventer-map_backend-data 위치에 저장
    driver: local

networks:
  eventer-network:
    # bridge 네트워크: 컨테이너 간 통신 가능
    # 컨테이너 이름으로 서로 접근 가능 (예: http://backend:8000)
    driver: bridge
