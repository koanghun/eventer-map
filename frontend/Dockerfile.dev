# ============================================
# 개발용 프론트엔드 Dockerfile (SSH 지원)
# ============================================
FROM node:20

WORKDIR /app

# SSH 서버 및 필수 도구 설치
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openssh-server \
        sudo \
        git \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# 기존 node 사용자(UID 1000)를 developer로 변경
RUN usermod -l developer -d /home/developer -m node && \
    groupmod -n developer node && \
    echo "developer ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers && \
    chown -R developer:developer /app

# SSH 설정
RUN mkdir -p /var/run/sshd && \
    mkdir -p /home/developer/.ssh && \
    chmod 700 /home/developer/.ssh && \
    chown -R developer:developer /home/developer/.ssh

# SSH 설정 파일 수정
# root 계정 SSH 로그인 차단 (보안 강화)
# 비밀번호 인증 허용 (개발 편의성)
# 공개키 인증 허용 (보안 권장)
# developer 사용자만 SSH 접속 허용
RUN sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin no/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication yes/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PubkeyAuthentication yes/PubkeyAuthentication yes/' /etc/ssh/sshd_config && \
    echo "AllowUsers developer" >> /etc/ssh/sshd_config

# entrypoint 스크립트 복사
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# 포트 노출
EXPOSE 3000 22

ENTRYPOINT ["/entrypoint.sh"]
