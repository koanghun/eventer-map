# Backend Environment Variables (Go / AWS SAM Serverless)
# 이 파일을 복사하여 backend/.env 파일을 생성한 후 실제 값으로 수정하세요:
#   cp backend/.env.example backend/.env

# ==========================================
# 1. 실행 환경 & 네트워크
# ==========================================
# 로컬 개발: local / AWS 배포 시 템플릿에서 prod 또는 dev로 자동 주입됨
ENV=local
PORT=8080

# CORS 허용 출처 (쉼표로 구분, 공백 없이)
# AWS 배포 시 template.yaml이 생성된 CloudFront URL을 자동으로 추가하므로 비워두거나 추가 커스텀 도메인만 입력 가능
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==========================================
# 2. 데이터베이스 (PostgreSQL)
# ==========================================
# 로컬 개발 및 DB 마이그레이션용 접속 URL (내부망 IP 사용 가능)
DATABASE_URL=postgresql://postgres:your_password@192.168.11.2:6930/postgres?sslmode=disable

# AWS Lambda 배포 전용 접속 URL (공인 IP / DDNS / Neon / RDS 등 외부에서 접근 가능한 주소)
# 설정 시 'make deploy-be'가 DATABASE_URL 대신 이 값을 AWS Lambda에 주입합니다.
PROD_DATABASE_URL=postgresql://postgres:your_password@your-nas-host.synology.me:6930/postgres?sslmode=require&connect_timeout=5

# ==========================================
# 3. JWT & 쿠키 보안 설정
# ==========================================
# 프로덕션 JWT 서명 시크릿 (32바이트 이상 랜덤 문자열 권장: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-strong-random-secret

# refreshToken 쿠키 설정
# CloudFront(*.cloudfront.net)와 API Gateway(*.amazonaws.com) 도메인이 다를 때는 None 필수
# 동일 루트 도메인(예: eventermap.com + api.eventermap.com) 사용 시 Lax + COOKIE_DOMAIN=.eventermap.com
COOKIE_SAMESITE=None
COOKIE_DOMAIN=

# ==========================================
# 4. X (Twitter) OAuth 2.0 (선택)
# ==========================================
# 비워두면 X 로그인/연동 기능이 비활성화(503)됩니다.
X_CLIENT_ID=
X_CLIENT_SECRET=
# AWS 배포 시 비워두면 CloudFront 기본 URL(https://<cloudfront>/auth/x/callback)로 자동 설정됩니다.
# 로컬 테스트 시: http://localhost:3000/auth/x/callback
X_REDIRECT_URI=
X_REQUEST_EMAIL=false

# ==========================================
# 5. SMTP 이메일 인증 발송 설정 (선택)
# ==========================================
# SMTP_HOST를 비워두면 콘솔/CloudWatch Logs에만 인증 코드를 출력하는 MockMailer로 동작합니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ==========================================
# 6. AWS 리소스 연동 (로컬 테스트 시에만 수동 지정)
# ==========================================
# AWS Lambda 배포 환경에서는 SAM(template.yaml)이 아래 값을 자동으로 주입합니다.
S3_MEDIA_BUCKET=
DYNAMODB_OAUTH_STATE_TABLE=
# 로컬 에뮬레이터(LocalStack / MinIO) 사용 시 선택:
# AWS_REGION=ap-northeast-1
# S3_ENDPOINT_URL=
# S3_PUBLIC_BASE_URL=
# DYNAMODB_ENDPOINT_URL=
