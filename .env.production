# ========================
# Event Map - Production Environment Variables
# ========================
# 시놀로지 NAS 프로덕션 배포용 환경 변수 설정 파일
# 사용 방법: 이 파일을 .env로 복사한 후 실제 값으로 수정하세요.
# 명령어: cp .env.production .env

# ========================
# Backend Configuration
# ========================

# 데이터베이스 설정 (PostgreSQL)
POSTGRES_USER=eventer
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD  # ⚠️ 변경 필요!
POSTGRES_DB=eventer_db
DATABASE_URL=postgresql://eventer:${POSTGRES_PASSWORD}@postgres:5432/eventer_db

# CORS 허용 출처 (쉼표로 구분, 공백 없이)
# ⚠️ 필수: 아래 값을 실제 도메인으로 변경하세요!
# 
# 예시 (도메인 사용 - HTTPS):
# CORS_ORIGINS=https://eventermap.mydns.jp
#
# 현재 설정 (변경 필요):
CORS_ORIGINS=https://eventermap.mydns.jp,http://localhost:7772

# Google OAuth 설정
# ⚠️ 필수: Google Cloud Console에서 발급한 OAuth 2.0 클라이언트 ID와 시크릿을 입력하세요
# 
# OAuth 클라이언트 ID 발급 방법:
# 1. https://console.cloud.google.com/ 접속
# 2. 프로젝트 선택 (Google Maps와 동일한 프로젝트 사용 가능)
# 3. "API 및 서비스" > "사용자 인증 정보" > "사용자 인증 정보 만들기" > "OAuth 클라이언트 ID" 선택
# 4. 애플리케이션 유형: "웹 애플리케이션" 선택
# 5. 승인된 자바스크립트 원본 추가:
#    예: https://eventermap.mydns.jp
# 6. 승인된 리디렉션 URI 추가:
#    예: https://eventermap.mydns.jp/api/auth/google/callback
# 7. 클라이언트 ID와 클라이언트 보안 비밀번호를 복사하여 아래에 입력
#
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE
GOOGLE_REDIRECT_URI=https://eventermap.mydns.jp/api/auth/google/callback
FRONTEND_URL=https://eventermap.mydns.jp

# JWT 인증 설정
# ⚠️ 필수: JWT_SECRET_KEY를 강력한 랜덤 문자열로 변경하세요!
# 생성 방법: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ========================
# Frontend Configuration
# ========================

# 백엔드 API URL
# ⚠️ 주의: 프론트엔드는 nginx에서 /api를 backend:8000으로 프록시하므로
# 이 값은 빌드 시에만 사용되며, 실제 API 호출은 nginx 프록시를 통해 이루어집니다.
# 
# 프로덕션에서는 도메인 사용
REACT_APP_API_URL=https://eventermap.mydns.jp/api

# Google Maps API Key
# ⚠️ 필수: Google Cloud Console에서 발급한 API 키를 입력하세요
# ⚠️ 보안: API 키에 HTTP 리퍼러 제한을 반드시 설정하세요!
# 
# API 키 발급 방법:
# 1. https://console.cloud.google.com/ 접속
# 2. 프로젝트 생성 또는 선택
# 3. "API 및 서비스" > "사용 설정된 API 및 서비스" > "API 사용 설정" 클릭
# 4. "Maps JavaScript API" 및 "Geocoding API" 검색 후 사용 설정
# 5. "사용자 인증 정보" > "사용자 인증 정보 만들기" > "API 키" 선택
# 6. API 키 생성 후 "키 제한" 설정:
#    - 애플리케이션 제한사항: HTTP 리퍼러 선택
#    - 웹사이트 제한사항 추가:
#      예: https://eventermap.mydns.jp/*
#    - API 제한사항: "Maps JavaScript API", "Geocoding API" 선택
#
REACT_APP_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# ========================
# Docker Compose Ports
# ========================

# 백엔드 포트 (배포: 7773)
# NAS의 다른 서비스와 포트 충돌이 있다면 변경하세요
BACKEND_PORT=7773

# 프론트엔드 포트 (배포: 7772)
# NAS의 다른 서비스와 포트 충돌이 있다면 변경하세요
FRONTEND_PORT=7772

ADMIN_EMAILS=YOUR_ADMIN_EMAILS_HERE

# ========================
# 배포 체크리스트
# ========================
# [ ] CORS_ORIGINS를 실제 도메인으로 변경 (https://eventermap.mydns.jp)
# [ ] GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET를 실제 OAuth 클라이언트 정보로 변경
# [ ] GOOGLE_REDIRECT_URI를 실제 도메인으로 변경 (https://eventermap.mydns.jp/api/auth/google/callback)
# [ ] FRONTEND_URL을 실제 도메인으로 변경 (https://eventermap.mydns.jp)
# [ ] JWT_SECRET_KEY를 강력한 랜덤 문자열로 변경 (openssl rand -hex 32)
# [ ] REACT_APP_GOOGLE_MAPS_API_KEY를 실제 API 키로 변경
# [ ] Google Maps API 키에 리퍼러 제한 설정 완료 (https://eventermap.mydns.jp/*)
# [ ] Google OAuth 클라이언트에 승인된 리디렉션 URI 설정 완료
# [ ] Synology DSM에서 Let's Encrypt 인증서 발급 완료
# [ ] Synology DSM에서 역방향 프록시 설정 완료 (eventermap.mydns.jp → localhost:7772)
