# ========================
# Event Map - Production Environment Variables
# ========================
# 시놀로지 NAS 프로덕션 배포용 환경 변수 설정 파일
# 사용 방법: 이 파일을 .env로 복사한 후 실제 값으로 수정하세요.
# 명령어: cp .env.production .env

# ========================
# Backend Configuration
# ========================

# 데이터베이스 URL
# SQLite 사용 (기본값, 데이터는 Docker 볼륨에 저장됨)
DATABASE_URL=sqlite:///./data/eventer.db

# CORS 허용 출처 (쉼표로 구분, 공백 없이)
# ⚠️ 필수: 아래 값을 실제 NAS IP 또는 도메인으로 변경하세요!
# 
# 예시 (NAS IP 사용):
# CORS_ORIGINS=http://192.168.1.100:3000,http://192.168.1.100
# 
# 예시 (도메인 사용):
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
#
# 현재 설정 (변경 필요):
CORS_ORIGINS=http://localhost:3000,http://localhost

# ========================
# Frontend Configuration
# ========================

# 백엔드 API URL
# ⚠️ 주의: 프론트엔드는 nginx에서 /api를 backend:8000으로 프록시하므로
# 이 값은 빌드 시에만 사용되며, 실제 API 호출은 nginx 프록시를 통해 이루어집니다.
# 
# 개발 환경에서는 localhost 사용
# 프로덕션에서는 NAS IP 또는 도메인 사용 (선택사항, nginx 프록시 사용 시 불필요)
REACT_APP_API_URL=http://localhost:8000

# Google Maps API Key
# ⚠️ 필수: Google Cloud Console에서 발급한 API 키를 입력하세요
# ⚠️ 보안: API 키에 HTTP 리퍼러 제한을 반드시 설정하세요!
# 
# API 키 발급 방법:
# 1. https://console.cloud.google.com/ 접속
# 2. 프로젝트 생성 또는 선택
# 3. "API 및 서비스" > "사용 설정된 API 및 서비스" > "API 사용 설정" 클릭
# 4. "Maps JavaScript API" 및 "Geocoding API" 검색 후 사용 설정
# 5. "사용자 인증 정보" > "사용자 인증 정보 만들기" > "API 키" 선택
# 6. API 키 생성 후 "키 제한" 설정:
#    - 애플리케이션 제한사항: HTTP 리퍼러 선택
#    - 웹사이트 제한사항 추가:
#      예: http://192.168.1.100:3000/*
#      예: https://yourdomain.com/*
#    - API 제한사항: "Maps JavaScript API", "Geocoding API" 선택
#
REACT_APP_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# ========================
# Docker Compose Ports
# ========================

# 백엔드 포트 (기본: 8000)
# NAS의 다른 서비스와 포트 충돌이 있다면 변경하세요
BACKEND_PORT=8000

# 프론트엔드 포트 (기본: 3000)
# NAS의 다른 서비스와 포트 충돌이 있다면 변경하세요
# 예: 8080, 8090 등
FRONTEND_PORT=3000

# ========================
# 배포 체크리스트
# ========================
# [ ] CORS_ORIGINS를 실제 NAS IP 또는 도메인으로 변경
# [ ] REACT_APP_GOOGLE_MAPS_API_KEY를 실제 API 키로 변경
# [ ] Google Maps API 키에 리퍼러 제한 설정 완료
# [ ] 포트 번호 확인 (다른 서비스와 충돌 여부)
# [ ] NAS 방화벽 설정 확인 (필요한 포트 개방)
